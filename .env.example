# Server-only. Never prefix these secrets with NEXT_PUBLIC_.
DEMO_ACCESS_CODE=
ACCESS_COOKIE_SECRET=
GEMINI_API_KEY=
SUPABASE_SECRET_KEY=
# Public connection information (safe to send to the browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Vercel's Supabase integration is also supported without renaming its variables:
# STORAGE_SUPABASE_URL
# STORAGE_SUPABASE_PUBLISHABLE_KEY (or NEXT_PUBLIC_STORAGE_SUPABASE_PUBLISHABLE_KEY)
# STORAGE_SUPABASE_SECRET_KEY (or STORAGE_SUPABASE_SERVICE_ROLE_KEY)
# Optional: trusted client IP header for rate limits, set only behind a trusted proxy.
# Vercel supplies x-vercel-forwarded-for in production.
# TRUSTED_IP_HEADER=x-vercel-forwarded-for
